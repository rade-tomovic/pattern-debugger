{
  "name": "debugger-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101218",
    "editor.foreground": "#d6d9e0"
  },
  "settings": [
    {
      "settings": {
        "foreground": "#d6d9e0",
        "background": "#101218"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8fa3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6fdd8b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f5b85c"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#b48cf2"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8a8fa3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "storage.type.cs",
        "storage.type.generic.cs"
      ],
      "settings": {
        "foreground": "#5cc8f5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.method.identifier"
      ],
      "settings": {
        "foreground": "#f5b85c"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d6d9e0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a0a5b8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f56c7b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}