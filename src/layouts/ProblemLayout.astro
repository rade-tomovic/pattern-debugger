---
import Base from '@layouts/Base.astro';
import PrevNext from '@components/PrevNext.astro';
import DifficultyBadge from '@components/DifficultyBadge.astro';
import Viz from '@components/viz/Viz.astro';
import {
  topicBySlug,
  topicPath,
  problemPath,
  resolveProblemRef,
  formatLc,
} from '@data/curriculum';

/**
 * Layout for problem pages.
 * MDX frontmatter contract: { layout, topic: '<topic-slug>', problem: '<problem-slug>' }
 */
const { frontmatter } = Astro.props;
const topic = topicBySlug(frontmatter.topic);
if (!topic) {
  throw new Error(`ProblemLayout: unknown topic "${frontmatter.topic}" in ${Astro.url.pathname}`);
}
const problem = topic.problems.find((p) => p.slug === frontmatter.problem);
if (!problem) {
  throw new Error(
    `ProblemLayout: unknown problem "${frontmatter.problem}" under topic "${topic.slug}" in ${Astro.url.pathname}`,
  );
}
const path = problemPath(topic, problem);
const lc = formatLc(problem.lc);
const related = (problem.related ?? []).map((ref) => {
  const r = resolveProblemRef(ref);
  return { title: r.problem.title, path: r.path, tab: r.topic.tab };
});
---

<Base title={`${problem.title} · ${topic.title}`} description={problem.summary}>
  <p class="text-muted font-mono text-[0.75rem]">
    <span class="text-line">stack&gt;</span>
    <a href={topicPath(topic)} class="hover:text-amber">{topic.tab}</a>
    <span class="text-line">/</span> <span class="text-amber"
      >{problem.slug.replaceAll('-', '_')}</span
    >
  </p>
  <h1 class="mt-3 font-mono text-[1.6rem] leading-tight font-semibold tracking-tight">
    <span class="text-muted">// </span>{problem.title}
  </h1>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <DifficultyBadge difficulty={problem.difficulty} />
    {lc && <span class="watch-chip">LC #{lc}</span>}
    <span class="watch-chip"><b>pattern</b> = {topic.tab}</span>
    {
      problem.track === 'stretch' && (
        <span class="text-purple border-purple/40 bg-purple-dim/60 rounded-md border px-2 py-0.5 font-mono text-[0.7rem]">
          stretch
        </span>
      )
    }
  </div>

  {problem.visualizer && <Viz id={problem.visualizer} />}

  <article class="article mt-8">
    <slot />
  </article>

  {
    related.length > 0 && (
      <section class="border-line mt-12 border-t pt-6">
        <h2 class="font-mono text-[1.05rem] font-semibold">
          <span class="text-muted">// </span>related problems
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {related.map((r) => (
            <li>
              <a
                href={r.path}
                class="watch-chip hover:border-muted inline-block transition-colors hover:text-amber"
              >
                {r.title} <span class="text-muted">({r.tab})</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <PrevNext path={path} />
</Base>
