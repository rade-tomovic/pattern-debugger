---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from '@layouts/Base.astro';
import PrevNext from '@components/PrevNext.astro';
import CheatCard from '@components/CheatCard.astro';
import Connections from '@components/Connections.astro';
import { sections, topicBySlug, topicPath } from '@data/curriculum';

// Head illustrations: hero/topics/<topic-slug>.astro, rendered when present. Each hero keeps its
// CSS in `<style is:inline>` so a page ships only its own hero's styles.
const heroes = import.meta.glob<{ default: AstroComponentFactory }>('../components/hero/topics/*.astro', {
  eager: true,
});

/**
 * Layout for topic pages (patterns, foundations, deep dives, reference).
 * MDX frontmatter contract: { layout, topic: '<topic-slug>' }
 * Title, summary, breadcrumb, and prev/next all come from curriculum.ts.
 */
const { frontmatter } = Astro.props;
const topic = topicBySlug(frontmatter.topic);
if (!topic) {
  throw new Error(`TopicLayout: unknown topic slug "${frontmatter.topic}" in ${Astro.url.pathname}`);
}
const section = sections.find((s) => s.id === topic.section)!;
const path = topicPath(topic);
const Hero = heroes[`../components/hero/topics/${topic.slug}.astro`]?.default;
---

<Base title={topic.title} description={topic.summary}>
  <p class="text-muted font-mono text-[0.75rem]">
    <span class="text-line">stack&gt;</span>
    {section.title.toLowerCase()} <span class="text-line">/</span> <span class="text-amber"
      >{topic.tab}</span
    >
  </p>
  <h1 class="mt-3 font-mono text-[1.6rem] leading-tight font-semibold tracking-tight">
    <span class="text-muted">// </span>{topic.title}
  </h1>
  <p class="text-muted mt-2 max-w-[64ch] text-[0.95rem]">{topic.summary}</p>
  {Hero && <Hero />}

  <article class="article mt-8">
    <slot />
    <CheatCard topic={topic.slug} title={`cheat sheet — ${topic.tab.replaceAll('_', ' ')}`} />
  </article>

  <Connections topic={topic.slug} />
  <PrevNext path={path} />
</Base>
