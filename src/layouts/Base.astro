---
import '@fontsource-variable/jetbrains-mono';
import '@styles/global.css';
import Sidebar from '@components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const site = Astro.site ?? new URL('https://pattern-debugger.pages.dev');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;
const ogType = Astro.url.pathname === '/' ? 'website' : 'article';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · pattern debugger</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="pattern debugger" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pattern debugger: step through every coding-interview pattern like a debugger." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="AMPQ" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <div class="mx-auto flex min-h-dvh max-w-6xl">
      <Sidebar />
      <main class="min-w-0 flex-1 px-4 pt-16 pb-24 sm:px-8 lg:pt-8">
        <slot />
        <footer class="border-line text-muted mt-20 border-t pt-6 font-mono text-xs">
          <p>
            <span class="text-muted">//</span> algorithm patterns for coding interviews · all
            solutions in C# · step through everything
          </p>
          <p class="mt-2">
            <span class="text-muted">//</span> built by
            <a href="https://ampq.dev/" class="text-ink underline decoration-line underline-offset-4 hover:decoration-amber"
              >AMPQ, a product development and platform engineering practice</a
            >. Source on
            <a
              href="https://github.com/rade-tomovic/pattern-debugger"
              class="text-ink underline decoration-line underline-offset-4 hover:decoration-amber">GitHub</a
            >, MIT licensed.
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
