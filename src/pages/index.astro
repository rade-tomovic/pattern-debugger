---
import Base from '@layouts/Base.astro';
import TracePlayer from '@components/viz/TracePlayer';
import { registry } from '@components/viz/registry';
import { sections, topics, topicsInSection, topicPath, type SectionId } from '@data/curriculum';

const hero = registry['two-pointers-sum'];
const heroSteps = hero.buildSteps();

const tracks: { title: string; blurb: string; sections: SectionId[] }[] = [
  {
    title: 'Algorithm patterns',
    blurb: 'The interview patterns in learning order, from complexity basics to DP and graphs.',
    sections: ['foundations', 'core', 'structures', 'advanced', 'deep-dives'],
  },
  {
    title: 'Systems',
    blurb: 'How the machine runs code: bits, the OS, the CPU, memory, the collector, the JIT, and concurrency.',
    sections: ['machine', 'memory', 'concurrency'],
  },
  {
    title: 'Networking',
    blurb: 'Packets and layers up through TCP, DNS, HTTP, and what to run when it breaks.',
    sections: ['network'],
  },
  {
    title: 'System design',
    blurb: 'Storage, replication, consistency, caching, queues, and the interview drills.',
    sections: ['system-design'],
  },
];

const untracked = sections.filter(
  (s) => s.id !== 'reference' && !tracks.some((t) => t.sections.includes(s.id)),
);
if (untracked.length > 0) {
  throw new Error(`index.astro: sections missing from home page tracks: ${untracked.map((s) => s.id).join(', ')}`);
}

const sectionTitle =(id: SectionId) => sections.find((s) => s.id === id)?.title ?? id;

const trackCards = tracks.map((track) => {
  const groups = track.sections.map((id) => ({ id, topics: topicsInSection(id) }));
  return { ...track, groups, topicCount: groups.flatMap((g) => g.topics).length };
});

const stats: [string, number][] = [
  ['topics', topics.length],
  ['problems', topics.reduce((n, t) => n + t.problems.length, 0)],
  ['players', Object.keys(registry).length],
];
---

<Base
  title="Algorithm Patterns in C#"
  description="Step through every coding-interview pattern like a debugger — templates, hand-verified traces, and interactive visualizers, all in modern C#."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'pattern debugger',
    url: 'https://pattern-debugger.pages.dev/',
    inLanguage: 'en',
    license: 'https://opensource.org/licenses/MIT',
    creator: {
      '@type': 'Organization',
      name: 'AMPQ',
      url: 'https://ampq.dev/',
      sameAs: ['https://github.com/rade-tomovic', 'https://www.linkedin.com/in/rade-tomovic'],
    },
  })} />
  <!-- hero -->
  <section class="mt-4">
    <h1 class="font-mono text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
      <span class="text-muted">//</span> algorithm pattern debugger
    </h1>
    <p class="text-muted mt-3 max-w-[60ch] text-[1.02rem]">
      Coding-interview patterns the way a debugger teaches them: one template per pattern, then
      a <strong class="text-ink">step-by-step trace of real state</strong> at every iteration.
      The same approach continues through how the machine runs code, how the network moves
      bytes, and system design. All code in modern C#, every snippet compiled and
      behavior-checked.
    </p>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        stats.map(([k, v]) => (
          <div class="watch-chip">
            <b>{k}</b> = {v}
          </div>
        ))
      }
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href="/reference/study-plan/"
        class="bg-amber text-bg hover:bg-amber/90 rounded-lg px-4 py-2 font-mono text-sm font-bold transition-colors"
      >
        start day_01 ▶
      </a>
      <a
        href="/deep-dives/pattern-recognition/"
        class="border-line bg-panel text-ink hover:border-amber hover:text-amber rounded-lg border px-4 py-2 font-mono text-sm transition-colors"
      >
        see x, think y
      </a>
      <a
        href="/reference/cheat-sheet/"
        class="text-muted hover:text-amber px-2 py-2 font-mono text-sm transition-colors"
      >
        cheat_sheet
      </a>
    </div>
  </section>

  <!-- live player -->
  <section class="mt-12" aria-label="Live demo: Two Sum II with opposite-end pointers">
    <TracePlayer client:load kind={hero.kind} steps={heroSteps} />
    <p class="text-muted mt-3 font-mono text-[0.75rem]">
      live: two_pointers on a sorted array. Click the player, then <kbd>◀</kbd>
      <kbd>▶</kbd> keys step.
    </p>
  </section>

  <!-- tracks -->
  <section class="mt-16" aria-label="Tracks">
    <ul class="grid gap-4 md:grid-cols-2">
      {
        trackCards.map((track) => (
          <li class="bg-panel border-line rounded-[10px] border p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="font-mono text-sm tracking-[0.1em] text-amber uppercase">{track.title}</h2>
              <span class="text-muted font-mono text-[0.68rem] whitespace-nowrap">
                {track.topicCount} topics
              </span>
            </div>
            <p class="text-muted mt-1.5 text-[0.85rem]">{track.blurb}</p>
            <div class="mt-4 space-y-3">
              {track.groups.map((g) => (
                <div>
                  {track.groups.length > 1 && (
                    <p class="text-muted font-mono text-[0.62rem] tracking-[0.12em] uppercase">
                      {sectionTitle(g.id)}
                    </p>
                  )}
                  <ul class="mt-1.5 flex flex-wrap gap-1.5">
                    {g.topics.map((t) => (
                      <li>
                        <a
                          href={topicPath(t)}
                          title={t.title}
                          class="border-line text-ink hover:border-amber hover:text-amber block rounded-md border px-2 py-0.5 font-mono text-[0.75rem] transition-colors"
                        >
                          {t.tab}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
