---
import type { Difficulty } from '@data/curriculum';

interface Props {
  difficulty: Difficulty;
}
const { difficulty } = Astro.props;

const cls = {
  easy: 'text-green border-green/40 bg-green-dim/60',
  medium: 'text-amber border-amber/40 bg-panel2',
  hard: 'text-red border-red/40 bg-red-dim/60',
}[difficulty];
---

<span class:list={['rounded-md border px-2 py-0.5 font-mono text-[0.7rem]', cls]}>
  {difficulty}
</span>
