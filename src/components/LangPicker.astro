---
/**
 * Site-wide solution-language picker. Renders NOTHING while languages.ts has
 * a single entry — it appears in the sidebar automatically the day a second
 * language lands. Selection persists in localStorage and broadcasts
 * LANG_EVENT; every <Solution> block follows it (and drops its local
 * override).
 */
import { languages } from '@data/languages';
---

{
  languages.length > 1 && (
    <div class="mt-5">
      <p class="font-mono text-[0.65rem] tracking-[0.12em] text-muted uppercase">language</p>
      <lang-picker class="mt-1.5 flex flex-wrap gap-1">
        {languages.map((l) => (
          <button type="button" data-lang={l.id}>
            {l.label}
          </button>
        ))}
      </lang-picker>
    </div>
  )
}

<style>
  lang-picker button {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.7rem;
    background: var(--color-panel);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  lang-picker button:hover {
    color: var(--color-ink);
    border-color: var(--color-muted);
  }
  lang-picker button[data-active] {
    background: var(--color-panel2);
    color: var(--color-amber);
    border-color: var(--color-amber);
  }
</style>

<script>
  import { defaultLang, LANG_STORAGE_KEY, LANG_EVENT } from '@data/languages';

  class LangPicker extends HTMLElement {
    connectedCallback() {
      let current = defaultLang;
      try {
        current = localStorage.getItem(LANG_STORAGE_KEY) ?? defaultLang;
      } catch {
        /* storage unavailable — fall back to default */
      }
      this.querySelectorAll('button').forEach((b) => {
        b.toggleAttribute('data-active', b.dataset.lang === current);
        b.addEventListener('click', () => {
          try {
            localStorage.setItem(LANG_STORAGE_KEY, b.dataset.lang ?? defaultLang);
          } catch {
            /* selection still applies for this page view */
          }
          this.querySelectorAll('button').forEach((x) =>
            x.toggleAttribute('data-active', x === b),
          );
          window.dispatchEvent(new CustomEvent(LANG_EVENT, { detail: b.dataset.lang }));
        });
      });
    }
  }

  if (!customElements.get('lang-picker')) customElements.define('lang-picker', LangPicker);
</script>
