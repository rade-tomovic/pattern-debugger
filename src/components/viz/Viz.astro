---
/**
 * Mounts the interactive step player for a visualizer id under the site's
 * mono "// step through it" heading.
 *
 * Steps are built HERE, at build time — the island receives them fully
 * serialized, so builders never ship to the client. Consequences:
 *   - an unknown id fails `astro build` with the known-id list
 *   - a registered-but-stubbed builder (see registry.ts) also fails the
 *     build, pointing at the file to create
 */
import TracePlayer from './TracePlayer';
import { registry } from './registry';

interface Props {
  id: string;
}
const { id } = Astro.props;

const spec = registry[id];
if (!spec) {
  throw new Error(
    `Viz: unknown visualizer id "${id}". Known ids: ${Object.keys(registry).sort().join(', ')}`,
  );
}
const steps = spec.buildSteps();
---

<section class="mt-8">
  <h2 class="font-mono text-[1.05rem] font-semibold">
    <span class="text-muted">// </span>step through it
  </h2>
  <p class="text-muted mt-1 font-mono text-[0.75rem]">
    click the player, then <kbd>◀</kbd> <kbd>▶</kbd> arrow keys step
  </p>
  <div class="mt-3">
    <TracePlayer client:visible kind={spec.kind} steps={steps} />
  </div>
</section>
