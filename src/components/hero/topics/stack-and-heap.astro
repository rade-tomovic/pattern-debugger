---
import HeroFrame from '../HeroFrame.astro';

/**
 * Two allocators, two lifetimes:
 *   Main holds `list`, a reference to a List<Order> on the heap
 *   call Load: rsp moves down, `n = 3` lives inline in the frame, `new Order()` lands on the heap
 *   return: rsp moves back, the frame is gone, nothing references the Order any more
 *   later: a GC finds no path to the Order and reclaims it; the List is still reachable
 * Un-animated styles are the final frame (reduced motion).
 */
---

<HeroFrame label="Main → Load() → return" caption="the stack frees a frame the instant the method returns; heap memory waits until a GC proves nobody can reach it">
  <div class="hero-stack-and-heap">
    <svg viewBox="0 0 320 196" role="img" aria-label="a call frame is pushed and popped on the stack while its heap object outlives it until a garbage collection">
      <text class="hd" x="10" y="12">stack · grows down</text>
      <text class="hd" x="190" y="12">heap · shared</text>

      <g class="main-frame">
        <rect class="frame" x="10" y="22" width="130" height="54" rx="6" />
        <text class="fname" x="18" y="38">Main</text>
        <text class="slot" x="18" y="62">list</text>
        <circle class="ref" cx="128" cy="58" r="3" />
      </g>

      <g class="load-frame">
        <rect class="frame load" x="10" y="82" width="130" height="72" rx="6" />
        <text class="fname" x="18" y="98">Load</text>
        <text class="slot" x="18" y="120">n = 3</text>
        <text class="slot" x="18" y="142">order</text>
        <circle class="ref" cx="128" cy="138" r="3" />
      </g>

      <g class="rsp">
        <line x1="10" y1="0" x2="140" y2="0" />
        <text x="10" y="12">rsp</text>
      </g>

      <g class="arrow a-list">
        <line x1="131" y1="58" x2="184" y2="48" />
        <polygon points="190,47 182,44 183,52" />
      </g>
      <g class="arrow a-order">
        <line x1="131" y1="138" x2="184" y2="130" />
        <polygon points="190,129 182,126 183,134" />
      </g>

      <g class="obj-list">
        <rect class="obj list" x="190" y="30" width="120" height="34" rx="6" />
        <text class="oname" x="250" y="47">List&lt;Order&gt;</text>
      </g>
      <g class="obj-order">
        <rect class="obj order" x="190" y="112" width="120" height="34" rx="6" />
        <text class="oname" x="250" y="129">Order</text>
      </g>
    </svg>
    <div class="readout font-mono">
      <span class="r r1">Main: <b class="text-ink">var list = new List&lt;Order&gt;()</b></span>
      <span class="r r2">call Load: rsp moves down · <b class="text-amber">new Order() goes to the heap</b></span>
      <span class="r r3">return: rsp moves back · <b class="text-red">frame gone, Order unreachable</b></span>
      <span class="r r4">later, a GC reclaims the Order · <b class="text-green">List is still reachable</b></span>
    </div>
  </div>
</HeroFrame>

<style is:inline>
  .hero-stack-and-heap {
    --t: 13s;
    width: 100%;
    max-width: 380px;
    animation: stack-and-heap-stage var(--t) linear infinite both;
  }
  .hero-stack-and-heap svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-stack-and-heap text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-ink);
    dominant-baseline: central;
  }
  .hero-stack-and-heap .hd {
    fill: var(--color-muted);
    font-size: 10px;
  }
  .hero-stack-and-heap .fname {
    fill: var(--color-muted);
    font-size: 10px;
  }
  .hero-stack-and-heap .oname {
    text-anchor: middle;
  }
  .hero-stack-and-heap .frame,
  .hero-stack-and-heap .obj {
    fill: var(--color-panel2);
    stroke: var(--color-line);
    stroke-width: 1.5;
  }
  .hero-stack-and-heap .ref {
    fill: var(--color-muted);
  }
  .hero-stack-and-heap .arrow line {
    stroke: var(--color-muted);
    stroke-width: 1.5;
  }
  .hero-stack-and-heap .arrow polygon {
    fill: var(--color-muted);
  }
  .hero-stack-and-heap .rsp line {
    stroke: var(--color-amber);
    stroke-width: 2;
  }
  .hero-stack-and-heap .rsp text {
    fill: var(--color-amber);
    font-size: 9px;
  }

  /* final frame: Load popped, Order collected, List reachable */
  .hero-stack-and-heap .load-frame,
  .hero-stack-and-heap .a-order,
  .hero-stack-and-heap .obj-order {
    opacity: 0;
  }
  .hero-stack-and-heap .rsp {
    transform: translateY(78px);
  }
  .hero-stack-and-heap .list {
    stroke: var(--color-green);
    fill: var(--color-green-dim);
  }
  .hero-stack-and-heap .load-frame { animation: stack-and-heap-load-frame var(--t) ease-in-out infinite both; }
  .hero-stack-and-heap .load { animation: stack-and-heap-load-stroke var(--t) linear infinite both; }
  .hero-stack-and-heap .rsp { animation: stack-and-heap-rsp var(--t) ease-in-out infinite both; }
  .hero-stack-and-heap .a-order { animation: stack-and-heap-a-order var(--t) linear infinite both; }
  .hero-stack-and-heap .obj-order { animation: stack-and-heap-obj-order var(--t) linear infinite both; }
  .hero-stack-and-heap .order { animation: stack-and-heap-order-stroke var(--t) linear infinite both; }
  .hero-stack-and-heap .list { animation: stack-and-heap-list-stroke var(--t) linear infinite both; }

  .hero-stack-and-heap .readout {
    display: grid;
    margin-top: 12px;
    font-size: 0.76rem;
    text-align: center;
  }
  .hero-stack-and-heap .readout b {
    font-weight: 600;
  }
  .hero-stack-and-heap .r {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hero-stack-and-heap .r4 { opacity: 1; }
  .hero-stack-and-heap .r1 { animation: stack-and-heap-r1 var(--t) linear infinite both; }
  .hero-stack-and-heap .r2 { animation: stack-and-heap-r2 var(--t) linear infinite both; }
  .hero-stack-and-heap .r3 { animation: stack-and-heap-r3 var(--t) linear infinite both; }
  .hero-stack-and-heap .r4 { animation: stack-and-heap-r4 var(--t) linear infinite both; }

  /* timeline: Main 0-22 · call 22-26 · Load 26-48 · return 48-52 · unreachable 52-72 · GC 72-78 · settled 78-94 · fade 94-100 */
  @keyframes stack-and-heap-stage {
    0% { opacity: 0; }
    3%, 95% { opacity: 1; }
    99%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-rsp {
    0%, 22% { transform: translateY(78px); }
    26%, 48% { transform: translateY(156px); }
    52%, 100% { transform: translateY(78px); }
  }
  @keyframes stack-and-heap-load-frame {
    0%, 22% { opacity: 0; transform: translateY(-8px); }
    26%, 49% { opacity: 1; transform: translateY(0); }
    53%, 100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes stack-and-heap-load-stroke {
    0%, 47% { stroke: var(--color-line); }
    49%, 100% { stroke: var(--color-red); }
  }
  @keyframes stack-and-heap-a-order {
    0%, 23% { opacity: 0; }
    26%, 48% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-obj-order {
    0%, 23% { opacity: 0; }
    26%, 50% { opacity: 1; }
    53%, 72% { opacity: 0.45; }
    77%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-order-stroke {
    0%, 48% { stroke: var(--color-amber); stroke-dasharray: none; fill: var(--color-panel2); }
    52%, 70% { stroke: var(--color-line); stroke-dasharray: 4 3; fill: var(--color-panel2); }
    73%, 100% { stroke: var(--color-red); stroke-dasharray: 4 3; fill: var(--color-red-dim); }
  }
  @keyframes stack-and-heap-list-stroke {
    0%, 72% { stroke: var(--color-line); fill: var(--color-panel2); }
    76%, 100% { stroke: var(--color-green); fill: var(--color-green-dim); }
  }

  @keyframes stack-and-heap-r1 {
    0%, 22% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-r2 {
    0%, 24% { opacity: 0; }
    26%, 47% { opacity: 1; }
    49%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-r3 {
    0%, 49% { opacity: 0; }
    51%, 71% { opacity: 1; }
    73%, 100% { opacity: 0; }
  }
  @keyframes stack-and-heap-r4 {
    0%, 73% { opacity: 0; }
    75%, 100% { opacity: 1; }
  }
</style>
