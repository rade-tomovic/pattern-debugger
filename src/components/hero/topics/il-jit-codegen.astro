---
import HeroFrame from '../HeroFrame.astro';

/**
 * SumLoop's method slot across its life, the pointer every call goes through:
 *   call 1: the slot points at a stub · the stub invokes the JIT, which compiles the
 *     24 bytes of IL into 161 bytes of tier-0 code and rewrites the slot to point at it
 *   calls 2 to ~30: each call reads the slot and runs tier-0 code, which counts the calls
 *     (the bar fills steadily, not per pulse: the pulses stand for many calls, not three)
 *   hot: the JIT compiles again, using those counts, into 29 bytes of tier-1 code
 *     and rewrites the slot a second time
 *   next call: runs tier-1 code · one call ran tier 0, the next runs tier 1
 * Un-animated styles are the final frame (reduced motion).
 */
const tiers = [
  { cls: 'bx-stub', x: 6, name: 'stub', sub: 'calls the JIT' },
  { cls: 'bx-t0', x: 114, name: 'tier 0 · 161 B', sub: 'instrumented' },
  { cls: 'bx-t1', x: 222, name: 'tier 1 · 29 B', sub: 'optimised, PGO' },
];
---

<HeroFrame label="SumLoop · tier 0 → tier 1" caption="warming up is one pointer write per method: the slot moves from tier-0 to tier-1 code, and the very next call runs the new bytes">
  <div class="hero-il-jit-codegen">
    <svg viewBox="0 0 320 192" role="img" aria-label="a method slot points at a stub, then at tier-0 code compiled by the JIT, then at tier-1 code once the method is hot">
      <rect class="box" x="6" y="20" width="84" height="32" rx="6" />
      <text x="48" y="36">caller</text>

      <g class="ar ar-call">
        <path d="M90 36 H113" />
        <polygon points="120,36 112,32 112,40" />
      </g>

      <rect class="box slot" x="120" y="20" width="80" height="32" rx="6" />
      <text class="sm" x="160" y="29">method slot</text>
      <text x="160" y="42">SumLoop</text>

      <rect class="box" x="222" y="20" width="92" height="32" rx="6" />
      <text class="sm cnt-label" x="268" y="29">call count</text>
      <text class="sm cnt-hot" x="268" y="29">hot</text>
      <rect class="bar-bg" x="232" y="38" width="72" height="6" rx="2" />
      <rect class="bar" x="232" y="38" width="72" height="6" rx="2" />

      <g class="ar ar-p-stub">
        <path d="M160 52 V70 H52 V87" />
        <polygon points="52,94 48,86 56,86" />
      </g>
      <g class="ar ar-p-t0">
        <path d="M160 52 V87" />
        <polygon points="160,94 156,86 164,86" />
      </g>
      <g class="ar ar-p-t1">
        <path d="M160 52 V70 H268 V87" />
        <polygon points="268,94 264,86 272,86" />
      </g>

      {
        tiers.map((b) => (
          <g class:list={['bx', b.cls]}>
            <rect class="box" x={b.x} y="94" width="92" height="36" rx="6" />
            <text x={b.x + 46} y="106">{b.name}</text>
            <text class="sm" x={b.x + 46} y="120">{b.sub}</text>
          </g>
        ))
      }

      <g class="ar ar-sj">
        <path d="M52 130 V172 H107" />
        <polygon points="114,172 106,168 106,176" />
      </g>
      <g class="ar ar-e0">
        <path d="M160 158 V137" />
        <polygon points="160,130 156,138 164,138" />
      </g>
      <g class="ar ar-e1">
        <path d="M206 172 H268 V137" />
        <polygon points="268,130 264,138 272,138" />
      </g>

      <rect class="box jit" x="114" y="158" width="92" height="30" rx="6" />
      <text x="160" y="167">JIT</text>
      <text class="sm" x="160" y="180">reads IL · 24 B</text>
    </svg>
    <div class="readout font-mono">
      <span class="r r0">call 1 → stub → JIT · <b class="text-amber">compiles tier 0, patches slot</b></span>
      <span class="r r1">calls 2 to ~30 read the slot · <b class="text-cyan">tier 0 runs, counting</b></span>
      <span class="r r2">hot · <b class="text-amber">JIT recompiles, slot rewritten to tier 1</b></span>
      <span class="r r3">the next call runs tier 1 · <b class="text-green">a step, not a ramp</b></span>
    </div>
  </div>
</HeroFrame>

<style is:inline>
  .hero-il-jit-codegen {
    --t: 13s;
    width: 100%;
    max-width: 380px;
    animation: il-jit-codegen-stage var(--t) linear infinite both;
  }
  .hero-il-jit-codegen svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-il-jit-codegen text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--color-ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .hero-il-jit-codegen .sm {
    fill: var(--color-muted);
    font-size: 9px;
  }
  .hero-il-jit-codegen .cnt-hot {
    fill: var(--color-ink);
    font-weight: 600;
  }
  .hero-il-jit-codegen .box {
    fill: var(--color-panel2);
    stroke: var(--color-line);
    stroke-width: 1.5;
  }
  .hero-il-jit-codegen .bar-bg {
    fill: none;
    stroke: var(--color-line);
  }
  .hero-il-jit-codegen .bar {
    fill: var(--color-muted);
    transform-box: fill-box;
    transform-origin: left center;
  }
  .hero-il-jit-codegen .ar {
    color: var(--color-muted);
  }
  .hero-il-jit-codegen .ar path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .hero-il-jit-codegen .ar polygon {
    fill: currentColor;
  }

  /* final frame: slot points at tier 1, stub and tier 0 no longer used, count full */
  .hero-il-jit-codegen .cnt-label,
  .hero-il-jit-codegen .ar-p-stub,
  .hero-il-jit-codegen .ar-p-t0 {
    opacity: 0;
  }
  .hero-il-jit-codegen .ar-sj,
  .hero-il-jit-codegen .ar-e0,
  .hero-il-jit-codegen .ar-e1 {
    opacity: 0.3;
  }
  .hero-il-jit-codegen .bx-stub,
  .hero-il-jit-codegen .bx-t0 {
    opacity: 0.5;
  }
  .hero-il-jit-codegen .ar-p-t1 {
    color: var(--color-green);
  }
  .hero-il-jit-codegen .bx-t1 .box {
    stroke: var(--color-green);
    fill: var(--color-green-dim);
  }

  .hero-il-jit-codegen .ar-call { animation: il-jit-codegen-ar-call var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-p-stub { animation: il-jit-codegen-ar-p-stub var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-p-t0 { animation: il-jit-codegen-ar-p-t0 var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-p-t1 { animation: il-jit-codegen-ar-p-t1 var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-sj { animation: il-jit-codegen-ar-sj var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-e0 { animation: il-jit-codegen-ar-e0 var(--t) linear infinite both; }
  .hero-il-jit-codegen .ar-e1 { animation: il-jit-codegen-ar-e1 var(--t) linear infinite both; }
  .hero-il-jit-codegen .jit { animation: il-jit-codegen-jit var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-stub { animation: il-jit-codegen-bx-stub var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-stub .box { animation: il-jit-codegen-box-stub var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-t0 { animation: il-jit-codegen-bx-t0 var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-t0 .box { animation: il-jit-codegen-box-t0 var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-t1 { animation: il-jit-codegen-bx-t1 var(--t) linear infinite both; }
  .hero-il-jit-codegen .bx-t1 .box { animation: il-jit-codegen-box-t1 var(--t) linear infinite both; }
  .hero-il-jit-codegen .bar { animation: il-jit-codegen-bar var(--t) linear infinite both; }
  .hero-il-jit-codegen .cnt-label { animation: il-jit-codegen-cnt-label var(--t) linear infinite both; }
  .hero-il-jit-codegen .cnt-hot { animation: il-jit-codegen-cnt-hot var(--t) linear infinite both; }

  .hero-il-jit-codegen .readout {
    display: grid;
    margin-top: 12px;
    font-size: 0.76rem;
    text-align: center;
  }
  .hero-il-jit-codegen .readout b {
    font-weight: 600;
  }
  .hero-il-jit-codegen .r {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hero-il-jit-codegen .r3 { opacity: 1; }
  .hero-il-jit-codegen .r0 { animation: il-jit-codegen-r0 var(--t) linear infinite both; }
  .hero-il-jit-codegen .r1 { animation: il-jit-codegen-r1 var(--t) linear infinite both; }
  .hero-il-jit-codegen .r2 { animation: il-jit-codegen-r2 var(--t) linear infinite both; }
  .hero-il-jit-codegen .r3 { animation: il-jit-codegen-r3 var(--t) linear infinite both; }

  /* timeline: call 1 + tier-0 compile 3-24 · counted calls 26-46 · tier-1 compile + rewrite 50-70 · next call 72-80 · settled 80-95 · fade 95-100 */
  @keyframes il-jit-codegen-stage {
    0% { opacity: 0; }
    3%, 95% { opacity: 1; }
    99%, 100% { opacity: 0; }
  }
  @keyframes il-jit-codegen-ar-call {
    0%, 3% { color: var(--color-muted); }
    4%, 8% { color: var(--color-cyan); }
    9%, 27% { color: var(--color-muted); }
    28%, 30% { color: var(--color-cyan); }
    31%, 33% { color: var(--color-muted); }
    34%, 36% { color: var(--color-cyan); }
    37%, 39% { color: var(--color-muted); }
    40%, 42% { color: var(--color-cyan); }
    43%, 73% { color: var(--color-muted); }
    74%, 78% { color: var(--color-cyan); }
    79%, 100% { color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-ar-p-stub {
    0%, 3% { opacity: 1; color: var(--color-muted); }
    4%, 8% { opacity: 1; color: var(--color-cyan); }
    9%, 17% { opacity: 1; color: var(--color-muted); }
    20%, 100% { opacity: 0; color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-ar-p-t0 {
    0%, 16% { opacity: 0; color: var(--color-amber); }
    19%, 21% { opacity: 1; color: var(--color-amber); }
    24%, 27% { opacity: 1; color: var(--color-muted); }
    28%, 30% { opacity: 1; color: var(--color-cyan); }
    31%, 33% { opacity: 1; color: var(--color-muted); }
    34%, 36% { opacity: 1; color: var(--color-cyan); }
    37%, 39% { opacity: 1; color: var(--color-muted); }
    40%, 42% { opacity: 1; color: var(--color-cyan); }
    43%, 62% { opacity: 1; color: var(--color-muted); }
    66%, 100% { opacity: 0; color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-ar-p-t1 {
    0%, 62% { opacity: 0; color: var(--color-amber); }
    66%, 71% { opacity: 1; color: var(--color-amber); }
    74%, 78% { opacity: 1; color: var(--color-cyan); }
    81%, 100% { opacity: 1; color: var(--color-green); }
  }
  @keyframes il-jit-codegen-ar-sj {
    0%, 7% { opacity: 0.3; color: var(--color-muted); }
    9%, 17% { opacity: 1; color: var(--color-cyan); }
    20%, 100% { opacity: 0.3; color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-ar-e0 {
    0%, 10% { opacity: 0.3; color: var(--color-muted); }
    12%, 18% { opacity: 1; color: var(--color-amber); }
    21%, 100% { opacity: 0.3; color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-ar-e1 {
    0%, 52% { opacity: 0.3; color: var(--color-muted); }
    54%, 61% { opacity: 1; color: var(--color-amber); }
    64%, 100% { opacity: 0.3; color: var(--color-muted); }
  }
  @keyframes il-jit-codegen-jit {
    0%, 8% { stroke: var(--color-line); }
    10%, 18% { stroke: var(--color-amber); }
    21%, 50% { stroke: var(--color-line); }
    52%, 61% { stroke: var(--color-amber); }
    64%, 100% { stroke: var(--color-line); }
  }
  @keyframes il-jit-codegen-bx-stub {
    0%, 17% { opacity: 1; }
    22%, 100% { opacity: 0.5; }
  }
  @keyframes il-jit-codegen-box-stub {
    0%, 3% { stroke: var(--color-line); }
    5%, 8% { stroke: var(--color-cyan); }
    10%, 100% { stroke: var(--color-line); }
  }
  @keyframes il-jit-codegen-bx-t0 {
    0%, 11% { opacity: 0.35; }
    14%, 62% { opacity: 1; }
    68%, 100% { opacity: 0.5; }
  }
  @keyframes il-jit-codegen-box-t0 {
    0%, 11% { stroke: var(--color-line); stroke-dasharray: 3 3; }
    13%, 18% { stroke: var(--color-amber); stroke-dasharray: none; }
    21%, 27% { stroke: var(--color-line); stroke-dasharray: none; }
    28%, 30% { stroke: var(--color-cyan); stroke-dasharray: none; }
    31%, 33% { stroke: var(--color-line); stroke-dasharray: none; }
    34%, 36% { stroke: var(--color-cyan); stroke-dasharray: none; }
    37%, 39% { stroke: var(--color-line); stroke-dasharray: none; }
    40%, 42% { stroke: var(--color-cyan); stroke-dasharray: none; }
    43%, 100% { stroke: var(--color-line); stroke-dasharray: none; }
  }
  @keyframes il-jit-codegen-bx-t1 {
    0%, 53% { opacity: 0.35; }
    56%, 100% { opacity: 1; }
  }
  @keyframes il-jit-codegen-box-t1 {
    0%, 53% { stroke: var(--color-line); fill: var(--color-panel2); stroke-dasharray: 3 3; }
    55%, 71% { stroke: var(--color-amber); fill: var(--color-panel2); stroke-dasharray: none; }
    74%, 78% { stroke: var(--color-cyan); fill: var(--color-panel2); stroke-dasharray: none; }
    81%, 100% { stroke: var(--color-green); fill: var(--color-green-dim); stroke-dasharray: none; }
  }
  @keyframes il-jit-codegen-bar {
    0%, 27% { transform: scaleX(0); }
    44%, 100% { transform: scaleX(1); }
  }
  @keyframes il-jit-codegen-cnt-label {
    0%, 44% { opacity: 1; }
    46%, 100% { opacity: 0; }
  }
  @keyframes il-jit-codegen-cnt-hot {
    0%, 44% { opacity: 0; }
    46%, 100% { opacity: 1; }
  }

  @keyframes il-jit-codegen-r0 {
    0%, 23% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }
  @keyframes il-jit-codegen-r1 {
    0%, 24% { opacity: 0; }
    26%, 47% { opacity: 1; }
    49%, 100% { opacity: 0; }
  }
  @keyframes il-jit-codegen-r2 {
    0%, 48% { opacity: 0; }
    50%, 71% { opacity: 1; }
    73%, 100% { opacity: 0; }
  }
  @keyframes il-jit-codegen-r3 {
    0%, 72% { opacity: 0; }
    74%, 100% { opacity: 1; }
  }
</style>
