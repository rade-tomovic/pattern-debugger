  }
  @keyframes transactions-row-a {
    0%, 37% { stroke: var(--color-line); }
    40%, 47% { stroke: var(--color-amber); }
    50%, 100% { stroke: var(--color-line); }
  }
  @keyframes transactions-row-b {
    0%, 58% { stroke: var(--color-line); }
    61%, 68% { stroke: var(--color-amber); }
    71%, 100% { stroke: var(--color-line); }
  }
  @keyframes transactions-on-a {
    0%, 46% { opacity: 1; }
    48%, 100% { opacity: 0; }
  }
  @keyframes transactions-off-a {
    0%, 46% { opacity: 0; }
    48%, 100% { opacity: 1; }
  }
  @keyframes transactions-on-b {
    0%, 67% { opacity: 1; }
    69%, 100% { opacity: 0; }
  }
  @keyframes transactions-off-b {
    0%, 67% { opacity: 0; }
    69%, 100% { opacity: 1; }
  }
  @keyframes transactions-c2 {
    0%, 46% { opacity: 1; }
    48%, 100% { opacity: 0; }
  }
  @keyframes transactions-c1 {
    0%, 46% { opacity: 0; }
    48%, 67% { opacity: 1; }
    69%, 100% { opacity: 0; }
  }
  @keyframes transactions-c0 {
    0%, 67% { opacity: 0; }
    69%, 100% { opacity: 1; }
  }
  @keyframes transactions-count {
    0%, 46% { stroke: var(--color-line); fill: var(--color-panel2); }
    48%, 67% { stroke: var(--color-green); fill: var(--color-panel2); }
    69%, 100% { stroke: var(--color-red); fill: var(--color-red-dim); }
  }

  @keyframes transactions-r1 {
    0%, 18% { opacity: 1; }
    20%, 100% { opacity: 0; }
  }
  @keyframes transactions-r2 {
    0%, 20% { opacity: 0; }
    22%, 36% { opacity: 1; }
    38%, 100% { opacity: 0; }
  }
  @keyframes transactions-r3 {
    0%, 38% { opacity: 0; }
    40%, 57% { opacity: 1; }
    59%, 100% { opacity: 0; }
  }
  @keyframes transactions-v3 {
    0%, 46% { opacity: 0; }
    48%, 100% { opacity: 1; }
  }
  @keyframes transactions-r4 {
    0%, 59% { opacity: 0; }
    61%, 79% { opacity: 1; }
    81%, 100% { opacity: 0; }
  }
  @keyframes transactions-v4 {
    0%, 67% { opacity: 0; }
    69%, 100% { opacity: 1; }
  }
  @keyframes transactions-r5 {
    0%, 81% { opacity: 0; }
    83%, 100% { opacity: 1; }
  }
</style>
