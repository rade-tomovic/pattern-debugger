---
import HeroFrame from '../HeroFrame.astro';

/**
 * Lomuto Partition on [5, 3, 8, 4, 2, 7, 6], pivot = arr[6] = 6. Frames are computed at build
 * time by running the partition loop itself, one frame per j (state before that step):
 *   j = 0: 5 <= 6 → swap(i=0, j=0), i → 1      j = 3: 4 <= 6 → swap(i=2, j=3), i → 3
 *   j = 1: 3 <= 6 → swap(i=1, j=1), i → 2      j = 4: 2 <= 6 → swap(i=3, j=4), i → 4
 *   j = 2: 8 > 6 → no swap                     j = 5: 7 > 6 → no swap
 *   then swap(arr[4], arr[6]): the pivot lands at index 4, its final sorted position
 * Cells left of i are <= pivot, cells in [i, j) are > pivot. Crossfaded; the final frame holds
 * for two slots. Un-animated styles show the final frame (reduced motion).
 */
const input = [5, 3, 8, 4, 2, 7, 6];

type Step = { arr: number[]; i: number; j: number; take: boolean };
const arr = [...input];
const hi = arr.length - 1;
const pivot = arr[hi];
const steps: Step[] = [];
let i = 0;
for (let j = 0; j < hi; j++) {
  const take = arr[j] <= pivot;
  steps.push({ arr: [...arr], i, j, take });
  if (take) {
    [arr[i], arr[j]] = [arr[j], arr[i]];
    i++;
  }
}
const beforeFinalSwap = [...arr];
[arr[i], arr[hi]] = [arr[hi], arr[i]];
const p = i;

const slots = steps.length + 3;
const delay = (k: number) => `animation-delay: calc(var(--t) * ${(k / slots - 1).toFixed(4)})`;
const region = (c: number, i: number, j: number) => (c < i ? 'le' : c < j ? 'gt' : '');
type Badge = { t: string; c: string };
const badgesAt = (c: number, i: number | null, j: number | null, pivotAt: number, pivotColor: string) =>
  [i === c && { t: 'i', c: 'amber' }, j === c && { t: 'j', c: 'cyan' }, pivotAt === c && { t: 'P', c: pivotColor }].filter(
    (b): b is Badge => Boolean(b),
  );
---

<HeroFrame label={`partition · pivot = ${pivot}`} caption="partition leaves the pivot at its final sorted index, so quickselect can drop a side">
  <div class="hero-sorting font-mono" style={`--slots: ${slots}`}>
    <div class="layers">
      {
        steps.map((s, k) => (
          <div class="layer" style={delay(k)}>
            <div class="cells">
              {s.arr.map((v, c) => (
                <div class="col">
                  <div class="badges">
                    {badgesAt(c, s.i, s.j, hi, 'muted').map((b) => (
                      <span class={`badge ${b.c}`}>{b.t}</span>
                    ))}
                  </div>
                  <div class:list={['cell', region(c, s.i, s.j), c === s.j && 'read', c === hi && 'pivot']}>{v}</div>
                  <div class="idx">{c}</div>
                </div>
              ))}
            </div>
            <p class="note">
              {s.take ? (
                <>
                  arr[{s.j}] = {s.arr[s.j]} ≤ {pivot} ·{' '}
                  <b class="text-amber">
                    swap(i={s.i}, j={s.j}), i → {s.i + 1}
                  </b>
                </>
              ) : (
                <>
                  arr[{s.j}] = {s.arr[s.j]} &gt; {pivot} · <b class="text-red">no swap</b>
                </>
              )}
            </p>
          </div>
        ))
      }
      <div class="layer" style={delay(steps.length)}>
        <div class="cells">
          {
            beforeFinalSwap.map((v, c) => (
              <div class="col">
                <div class="badges">
                  {badgesAt(c, p, null, hi, 'muted').map((b) => (
                    <span class={`badge ${b.c}`}>{b.t}</span>
                  ))}
                </div>
                <div class:list={['cell', c !== hi && region(c, p, hi), (c === p || c === hi) && 'write', c === hi && 'pivot']}>{v}</div>
                <div class="idx">{c}</div>
              </div>
            ))
          }
        </div>
        <p class="note">
          scan done · <b class="text-amber">swap(arr[{p}], arr[{hi}])</b> · pivot into i = {p}
        </p>
      </div>
      <div class="layer final" style={delay(steps.length + 1)}>
        <div class="cells">
          {
            arr.map((v, c) => (
              <div class="col">
                <div class="badges">
                  {badgesAt(c, null, null, p, 'green').map((b) => (
                    <span class={`badge ${b.c}`}>{b.t}</span>
                  ))}
                </div>
                <div class:list={['cell', c < p ? 'le' : c === p ? 'done' : 'gt']}>{v}</div>
                <div class="idx">{c}</div>
              </div>
            ))
          }
        </div>
        <p class="note">
          ≤ {pivot} left, &gt; {pivot} right · <b class="text-green">{pivot} is final at index {p}</b>
        </p>
      </div>
    </div>
  </div>
</HeroFrame>

<style is:inline>
  .hero-sorting {
    --t: calc(var(--slots) * 1.5s);
    --cell: 38px;
    width: 100%;
    max-width: 400px;
    font-size: 0.78rem;
  }
  .hero-sorting .layers {
    display: grid;
  }
  .hero-sorting .layer {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: sorting-frame var(--t) linear infinite both;
  }
  .hero-sorting .layer.final {
    opacity: 1;
    animation-name: sorting-final;
  }
  .hero-sorting .cells {
    display: flex;
    gap: 6px;
  }
  .hero-sorting .col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hero-sorting .badges {
    display: flex;
    gap: 2px;
    height: 18px;
  }
  .hero-sorting .badge {
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 18px;
    padding: 0 4px;
    border-radius: 4px;
    color: var(--color-bg);
  }
  .hero-sorting .badge.amber {
    background: var(--color-amber);
  }
  .hero-sorting .badge.cyan {
    background: var(--color-cyan);
  }
  .hero-sorting .badge.green {
    background: var(--color-green);
  }
  .hero-sorting .badge.muted {
    background: var(--color-line);
    color: var(--color-ink);
  }
  .hero-sorting .cell {
    width: var(--cell);
    height: var(--cell);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: var(--color-ink);
    background: var(--color-panel2);
    border: 1px solid var(--color-line);
    border-radius: 8px;
  }
  .hero-sorting .cell.le {
    background: var(--color-win-dim);
    border-color: var(--color-green);
  }
  .hero-sorting .cell.gt {
    background: var(--color-red-dim);
    border-color: var(--color-red);
  }
  .hero-sorting .cell.pivot {
    border-style: dashed;
    border-color: var(--color-muted);
  }
  .hero-sorting .cell.read {
    border: 2px solid var(--color-cyan);
  }
  .hero-sorting .cell.write {
    border: 2px solid var(--color-amber);
  }
  .hero-sorting .cell.done {
    background: var(--color-green-dim);
    border: 2px solid var(--color-green);
  }
  .hero-sorting .idx {
    color: var(--color-muted);
    font-size: 0.65rem;
  }
  .hero-sorting .note {
    margin: 0;
    text-align: center;
  }
  .hero-sorting b {
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .hero-sorting {
      --cell: 32px;
    }
    .hero-sorting .cells {
      gap: 4px;
    }
  }

  @keyframes sorting-frame {
    0% { opacity: 0; }
    1.5%, 10% { opacity: 1; }
    11.1%, 100% { opacity: 0; }
  }
  @keyframes sorting-final {
    0% { opacity: 0; }
    1.5%, 20.5% { opacity: 1; }
    22.2%, 100% { opacity: 0; }
  }
</style>
