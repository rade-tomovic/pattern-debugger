---
import HeroFrame from '../HeroFrame.astro';

/**
 * Check-then-act with atomic parts, the page's shape 2: capacity 1, seats = 0, and both threads run
 *   if (Volatile.Read(ref seats) < 1) { Interlocked.Increment(ref seats); Interlocked.Increment(ref admitted); }
 * The interleaving below is executed here at build time against that exact body:
 *   A checks: reads 0, 0 < 1 passes
 *   B checks: reads 0, 0 < 1 passes, because A has not acted yet
 *   A acts: seats = 1, admitted = 1
 *   B acts on its stale check: seats = 2, admitted = 2, one seat sold twice
 * Every access is atomic; the span from A's check to A's act is not, and B lands inside it.
 * Un-animated styles are the final frame (reduced motion).
 */
const capacity = 1;
const schedule: ['A' | 'B', 'check' | 'act'][] = [
  ['A', 'check'],
  ['B', 'check'],
  ['A', 'act'],
  ['B', 'act'],
];

let seats = 0;
let admitted = 0;
const passed: Record<string, boolean> = {};
const steps = schedule.map(([thread, op]) => {
  if (op === 'check') {
    const read = seats;
    passed[thread] = read < capacity;
    return { thread, op, top: 'check', bottom: `${read} < ${capacity} ${passed[thread] ? '✓' : '✗'}`, seats, admitted };
  }
  if (passed[thread]) {
    seats++;
    admitted++;
  }
  return { thread, op, top: 'act', bottom: `seats=${seats}`, seats, admitted };
});
const oversold = admitted > capacity;
const final = steps[steps.length - 1];
const afterFirstAct = steps[2];

const colX = (k: number) => 66 + k * 72;
const laneY = { A: 44, B: 94 };
const aCheck = schedule.findIndex(([t, o]) => t === 'A' && o === 'check');
const aAct = schedule.findIndex(([t, o]) => t === 'A' && o === 'act');
const band = { x: colX(aCheck) - 36, w: colX(aAct) - colX(aCheck) + 72 };
---

<HeroFrame label={`check-then-act · capacity ${capacity}, threads A and B`} caption="the unit that must be indivisible is the span from check to act, not each access inside it">
  <div class="hero-concurrency-hazards">
    <svg viewBox="0 0 340 204" role="img" aria-label="threads A and B both check that a seat is free before either one takes it, so both take it and the seat is sold twice">
      <g class="band">
        <rect x={band.x} y="20" width={band.w} height="100" rx="6" />
        <text x={band.x + band.w / 2} y="10">A: check → act is not one step</text>
      </g>

      {
        (['A', 'B'] as const).map((t) => (
          <>
            <line class="lane" x1="30" y1={laneY[t]} x2="334" y2={laneY[t]} />
            <text class="tn" x="14" y={laneY[t]}>{t}</text>
          </>
        ))
      }
      <line class="axis" x1="30" y1="132" x2="326" y2="132" />
      <polygon class="axis-head" points="334,132 326,128 326,136" />
      <text class="cap" x="30" y="143">time</text>

      {
        steps.map((s, k) => (
          <g class={`op s${k + 1} ${s.op}${s.op === 'act' && oversold && k === steps.length - 1 ? ' bad' : ''}`} transform={`translate(${colX(k)} ${laneY[s.thread]})`}>
            <rect x="-32" y="-18" width="64" height="36" rx="6" />
            <text class="top" y="-7">{s.top}</text>
            <text class="bot" y="8">{s.bottom}</text>
          </g>
        ))
      }

      <text class="lbl" x="12" y="176">seats</text>
      <rect class="cell" x="54" y="160" width="44" height="32" rx="6" />
      <text class="val u0" x="76" y="176">0</text>
      <text class="val u1" x="76" y="176">{afterFirstAct.seats}</text>
      <text class="val u2" x="76" y="176">{final.seats}</text>

      <text class="lbl" x="114" y="176">admitted</text>
      <rect class="cell" x="174" y="160" width="44" height="32" rx="6" />
      <text class="val u0" x="196" y="176">0</text>
      <text class="val u1" x="196" y="176">{afterFirstAct.admitted}</text>
      <text class="val u2" x="196" y="176">{final.admitted}</text>

      <text class="cap" x="240" y="176">capacity {capacity}</text>
    </svg>
    <div class="readout font-mono">
      <span class="r r1">A: Volatile.Read(seats) = {steps[0].seats} · <b class="text-cyan">check passes</b></span>
      <span class="r r2">A has not acted yet · <b class="text-cyan">B's check passes too</b></span>
      <span class="r r3">A: Interlocked.Increment · <b class="text-amber">seats = {afterFirstAct.seats}</b></span>
      <span class="r r4">B acts on a stale check · <b class="text-red">seats = {final.seats}, sold twice</b></span>
      <span class="r r5">no data race here · <b class="text-red">still a race condition</b></span>
    </div>
  </div>
</HeroFrame>

